#!/usr/bin/env bash
set -euo pipefail

# Usage: artifact-publisher-config <mapping-json>
# The gallery URL lists every publication on a public host, so its token stays
# out of git and the world-readable Nix store: it is generated here once and
# merged into the mapping file on every activation.
readonly mapping="$1"
readonly config_path="${XDG_CONFIG_HOME:-$HOME/.config}/faviann-skills/artifacts.json"
readonly token_path="${XDG_STATE_HOME:-$HOME/.local/state}/faviann-skills/artifact-gallery"

umask 077
temporary=
trap 'rm -f "$temporary"' EXIT

if [[ ! -e "$token_path" ]]; then
  mkdir -p "$(dirname "$token_path")"
  temporary="$(mktemp "$token_path.XXXXXX")"
  od -An -N16 -tx1 /dev/urandom | tr -d ' \n' >"$temporary"
  mv -T "$temporary" "$token_path"
fi

token="$(<"$token_path")"
if [[ ! "$token" =~ ^[A-Za-z0-9_-]{16,}$ ]]; then
  printf 'Artifact gallery token at %s is not one path segment of at least 16 [A-Za-z0-9_-]; delete it to regenerate\n' \
    "$token_path" >&2
  exit 1
fi

mkdir -p "$(dirname "$config_path")"
temporary="$(mktemp "$config_path.XXXXXX")"
jq --rawfile gallery "$token_path" '. + {gallery: ($gallery | rtrimstr("\n"))}' \
  <<<"$mapping" >"$temporary"
mv -T "$temporary" "$config_path"
