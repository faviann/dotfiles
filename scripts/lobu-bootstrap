#!/usr/bin/env bash
set -euo pipefail

# Installation only: login and device registration belong to the operator.
if [[ -x "$HOME/.local/bin/lobu" ]]; then
  exit 0
fi

npm install --global --prefix "$HOME/.local" --engine-strict @lobu/cli@latest
if [[ ! -x "$HOME/.local/bin/lobu" ]]; then
  printf 'Lobu bootstrap did not install ~/.local/bin/lobu\n' >&2
  exit 1
fi
