#!/usr/bin/env bash
set -euo pipefail

readonly REPO_ROOT="${1:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

shell_inputs=(
  "$REPO_ROOT/dot_local/bin/executable_dev-session"
  "$REPO_ROOT/dot_local/bin/executable_update-agent-tools"
  "$REPO_ROOT/dot_local/bin/executable_workstation-update"
  "$REPO_ROOT/dot_bash_profile.tmpl"
  "$REPO_ROOT/dot_bashrc.tmpl"
  "$REPO_ROOT"/tests/*.bats
  "$REPO_ROOT"/tests/*.bash
  "$REPO_ROOT/scripts/run-shellcheck"
  "$REPO_ROOT/scripts/collie-bootstrap"
  "$REPO_ROOT/scripts/lobu-bootstrap"
  "$REPO_ROOT/scripts/moraine-service"
  "$REPO_ROOT/scripts/update-dotnet-sdk"
)
template_inputs=("$REPO_ROOT"/.chezmoiscripts/*.sh.tmpl)

render_dir="$(mktemp -d)"
trap 'rm -rf "$render_dir"' EXIT

rendered_inputs=()
for is_workstation in true false; do
  variant_dir="$render_dir/is_workstation-$is_workstation"
  mkdir -p "$variant_dir/destination"

  for template in "${template_inputs[@]}"; do
    rendered="$variant_dir/$(basename "${template%.tmpl}")"
    chezmoi \
      --source "$REPO_ROOT" \
      --destination "$variant_dir/destination" \
      --config /dev/null \
      --config-format toml \
      --persistent-state "$variant_dir/chezmoistate.boltdb" \
      --override-data "{\"is_workstation\":$is_workstation}" \
      execute-template --file "$template" >"$rendered"
    rendered_inputs+=("$rendered")
  done
done

shellcheck \
  --external-sources \
  --shell=bash \
  --source-path="$REPO_ROOT" \
  "${shell_inputs[@]}" \
  "${rendered_inputs[@]}"
