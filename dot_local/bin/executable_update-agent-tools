#!/usr/bin/env bash
set -euo pipefail

fail() {
  printf 'update-agent-tools: %s\n' "$*" >&2
  exit 1
}

[[ $# -eq 0 ]] || fail 'usage: update-agent-tools'

prefix="$HOME/.local"
export PATH="$prefix/bin:$PATH"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/update-agent-tools"
mkdir -p "$state_dir"
exec 9>"$state_dir/lock"
flock 9

packages=(
  @openai/codex@latest
  @anthropic-ai/claude-code@latest
  @earendil-works/pi-coding-agent@latest
  opencode-ai@latest
  @oh-my-pi/pi-coding-agent@latest
)

# npm is moving install scripts behind an explicit allowlist and already warns
# about every unreviewed one. Approval cannot be recorded for a global install,
# so the allowlist is named on each invocation. The claude and opencode packages
# ship a placeholder executable that their install script replaces with the real
# binary, so a blocked script leaves a stub behind and still succeeds. A package
# that starts wanting an install script is absent from this list and warns
# instead of running.
allow_scripts=(
  @anthropic-ai/claude-code
  opencode-ai
  esbuild
  onnxruntime-node
  protobufjs
  @google/genai
)
allowed_scripts="$(IFS=,; printf '%s' "${allow_scripts[*]}")"

# npm owns resolution, dependency compatibility, integrity and installation. Its
# dry run enforces Node engines before replacing any executable. Bun engines are
# verified by running the harnesses below, using the latest upstream runtime.
mkdir -p "$prefix/lib"
npm install --global --prefix "$prefix" --force=false --engine-strict \
  --allow-scripts="$allowed_scripts" --dry-run "${packages[@]}" \
  || fail 'npm preflight failed; check package diagnostics and the Home Manager Node version'

# The upstream installer selects a CPU-compatible build and renames the extracted
# binary into place. This PATH already includes its destination, so the installer
# does not edit shell profiles. Keep bunx available without another installation.
curl -fsSL https://bun.sh/install | BUN_INSTALL="$prefix" bash \
  || fail 'Bun installation failed'
ln -sfn bun "$prefix/bin/bunx"
bun --version >/dev/null || fail 'installed Bun does not run on this workstation'
npm install --global --prefix "$prefix" --force=false --engine-strict \
  --allow-scripts="$allowed_scripts" "${packages[@]}" \
  || fail 'npm installation failed'

for harness in opencode omp pi; do
  "$harness" --version >/dev/null || fail "verification failed: $harness"
done
printf 'Agent tools updated.\n'
