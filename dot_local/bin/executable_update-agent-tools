#!/usr/bin/env bash
set -euo pipefail

fail() {
  printf 'update-agent-tools: %s\n' "$*" >&2
  exit 1
}

[[ $# -eq 0 ]] || fail 'usage: update-agent-tools'

prefix="$HOME/.local"
export PATH="$prefix/bin:$PATH"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/update-agent-tools"
mkdir -p "$state_dir"
exec 9>"$state_dir/lock"
flock 9

packages=(
  @openai/codex@latest
  @anthropic-ai/claude-code@latest
  @earendil-works/pi-coding-agent@latest
  opencode-ai@latest
)

# npm is moving install scripts behind an explicit allowlist and already warns
# about every unreviewed one. Approval cannot be recorded for a global install,
# so the allowlist is named on each invocation. The claude and opencode packages
# ship a placeholder executable that their install script replaces with the real
# binary, so a blocked script leaves a stub behind and still succeeds. A package
# that starts wanting an install script is absent from this list and warns
# instead of running.
allow_scripts=(
  @anthropic-ai/claude-code
  opencode-ai
  esbuild
  protobufjs
  @google/genai
)
allowed_scripts="$(IFS=,; printf '%s' "${allow_scripts[*]}")"

# npm owns resolution, dependency compatibility, integrity and installation. Its
# dry run enforces Node engines before replacing any executable. Bun engines are
# verified by running the harnesses below, using the latest upstream runtime.
mkdir -p "$prefix/lib"
npm install --global --prefix "$prefix" --force=false --engine-strict \
  --allow-scripts="$allowed_scripts" --dry-run "${packages[@]}" \
  || fail 'npm preflight failed; check package diagnostics and the Home Manager Node version'

# Bun's updater skips downloading an already-current binary. Keep the installer
# for bootstrap and repair; its destination is already on PATH.
if "$prefix/bin/bun" --version >/dev/null 2>&1; then
  "$prefix/bin/bun" upgrade --stable || fail 'Bun upgrade failed'
else
  curl -fsSL https://bun.sh/install | BUN_INSTALL="$prefix" bash \
    || fail 'Bun installation failed'
fi
ln -sfn bun "$prefix/bin/bunx"
bun --version >/dev/null || fail 'installed Bun does not run on this workstation'
npm install --global --prefix "$prefix" --force=false --engine-strict \
  --allow-scripts="$allowed_scripts" "${packages[@]}" \
  || fail 'npm installation failed'

for harness in opencode pi; do
  "$harness" --version >/dev/null || fail "verification failed: $harness"
done

# Claude Code's background plugin updates are off, and each update refreshes
# its marketplace. anthropic-plugin-directory is built in and absent from
# `claude plugin marketplace list`.
claude_marketplaces=(
  pstack-claude=michael-denyer/pstack-claude
  openai-codex=openai/codex-plugin-cc
)
claude_plugins=(
  pstack@pstack-claude
  codex@openai-codex
  frontend-design@anthropic-plugin-directory
  skill-creator@anthropic-plugin-directory
)
known_marketplaces="$(claude plugin marketplace list --json | jq -r '.[].name')" \
  || fail 'listing Claude Code plugin marketplaces failed'
for marketplace in "${claude_marketplaces[@]}"; do
  name="${marketplace%%=*}"
  grep -qxF "$name" <<<"$known_marketplaces" && continue
  claude plugin marketplace add "${marketplace#*=}" \
    || fail "Claude Code plugin marketplace add failed: $name"
done
installed_plugins="$(claude plugin list --json | jq -r '.[].id')" \
  || fail 'listing Claude Code plugins failed'
for plugin in "${claude_plugins[@]}"; do
  if grep -qxF "$plugin" <<<"$installed_plugins"; then
    claude plugin update "$plugin" || fail "Claude Code plugin update failed: $plugin"
  else
    claude plugin install "$plugin" || fail "Claude Code plugin install failed: $plugin"
  fi
done
printf 'Agent tools updated.\n'
