#!/usr/bin/env bash
set -euo pipefail

# A caller's environment token would shadow the stored token everywhere below;
# this command always speaks about the stored token.
unset GH_TOKEN GITHUB_TOKEN

readonly ITEM=dotfiles/github-cli-token

fail() {
  printf 'github-token: %s\n' "$*" >&2
  exit 1
}

usage() {
  fail 'usage: github-token rotate | check-expiry'
}

live_token() {
  local token

  token="$(gh auth token --hostname github.com 2>/dev/null)" || return 1
  token="${token//[[:space:]]/}"
  [[ -n "$token" ]] || return 1
  printf '%s' "$token"
}

# Sets http_status and token_expiry from GitHub's view of the token. An empty
# http_status means GitHub could not be reached.
inspect_token() {
  local response line

  http_status=''
  token_expiry=''
  response="$(GH_TOKEN="$1" gh api -i user 2>/dev/null)" || true
  while IFS= read -r line; do
    line="${line%$'\r'}"
    [[ -n "$line" ]] || break
    if [[ "$line" =~ ^HTTP/[0-9.]+\ ([0-9]{3}) ]]; then
      http_status="${BASH_REMATCH[1]}"
    elif [[ "${line%%:*}" == [Gg]ithub-[Aa]uthentication-[Tt]oken-[Ee]xpiration ]]; then
      token_expiry="${line#*:}"
      token_expiry="${token_expiry# }"
    fi
  done <<<"$response"
}

ensure_bitwarden_session() {
  command -v bw >/dev/null 2>&1 || fail 'Bitwarden CLI is missing'
  bw unlock --check >/dev/null 2>&1 \
    || fail "Bitwarden is locked; run: export BW_SESSION=\$(bw unlock --raw)"
}

rotate() {
  local new_token item_id

  [[ $# -eq 0 ]] || usage
  if [[ -t 0 ]]; then
    IFS= read -rsp 'New GitHub token: ' new_token
    printf '\n' >&2
  else
    IFS= read -r new_token || true
  fi
  new_token="${new_token//[[:space:]]/}"
  [[ -n "$new_token" ]] || fail 'no token entered'

  inspect_token "$new_token"
  [[ "$http_status" == 200 ]] \
    || fail "GitHub rejected the new token (HTTP ${http_status:-unreachable}); Bitwarden is unchanged"
  [[ -n "$token_expiry" ]] \
    || fail 'GitHub reported no expiry for the new token; create it with an expiration date'

  ensure_bitwarden_session
  item_id="$(bw get item "$ITEM" | jq -r .id)" \
    || fail "cannot find Bitwarden item $ITEM"
  # The token travels through the environment, never argv, which other local
  # users can read.
  bw get item "$item_id" \
    | NEW_TOKEN="$new_token" jq '.notes = env.NEW_TOKEN' \
    | bw encode \
    | bw edit item "$item_id" >/dev/null \
    || fail "cannot update Bitwarden item $ITEM"
  bw sync >/dev/null || fail 'Bitwarden sync failed'
  bw get item "$item_id" | jq -r '.notes' \
    | gh auth login --hostname github.com --with-token >/dev/null \
    || fail 'cannot reload the gh login from Bitwarden'

  [[ "$(live_token)" == "$new_token" ]] \
    || fail 'the gh login does not match Bitwarden after reload'
  printf 'github-token: token rotated; expires %s\n' "$token_expiry"
}

# Warnings only: this runs inside routine maintenance and must never fail it.
check_expiry() {
  local token expiry_epoch

  [[ $# -eq 0 ]] || usage
  token="$(live_token)" || return 0
  inspect_token "$token"
  case "$http_status" in
    200)
      [[ -n "$token_expiry" ]] || return 0
      expiry_epoch="$(date -d "$token_expiry" +%s 2>/dev/null)" || return 0
      if (( expiry_epoch - $(date +%s) <= 7 * 86400 )); then
        printf 'github-token: warning: the GitHub token expires %s; run github-token rotate\n' \
          "$token_expiry" >&2
      fi
      ;;
    401)
      printf 'github-token: warning: GitHub rejects the token as invalid or expired; run github-token rotate\n' >&2
      ;;
  esac
}

(( $# > 0 )) || usage
command="$1"
shift
case "$command" in
  rotate) rotate "$@" ;;
  check-expiry) check_expiry "$@" ;;
  *) usage ;;
esac
