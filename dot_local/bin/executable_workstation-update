#!/usr/bin/env bash
set -euo pipefail

update_started=$SECONDS
phase_started=

fail() {
  printf 'workstation-update: %s; correct the problem, then rerun workstation-update\n' \
    "$*" >&2
  if [[ -n "$phase_started" ]]; then
    printf '  Failed after %ss (total: %ss)\n' \
      "$((SECONDS - phase_started))" "$((SECONDS - update_started))" >&2
  fi
  exit 1
}

start_phase() {
  phase_started=$SECONDS
  printf '%s\n' "$1"
}

finish_phase() {
  printf '  Completed in %ss\n' "$((SECONDS - phase_started))"
  phase_started=
}

ensure_bitwarden_session() {
  local unlocked_session

  command -v bw >/dev/null 2>&1 \
    || fail 'credential phase failed: Bitwarden CLI is missing'
  if bw unlock --check >/dev/null 2>&1; then
    return
  fi
  [[ -t 0 && -t 2 ]] \
    || fail 'credential phase failed: Bitwarden is locked; run bw unlock --raw and export its output as BW_SESSION before unattended use'

  printf 'Secrets: unlocking Bitwarden to refresh secret-backed files...\n' >&2
  unset BW_SESSION
  unlocked_session="$(bw unlock --raw)" \
    || fail 'credential phase failed: Bitwarden unlock failed'
  [[ -n "$unlocked_session" && "$unlocked_session" != *$'\n'* ]] \
    || fail 'credential phase failed: Bitwarden returned an invalid session'
  export BW_SESSION="$unlocked_session"
  bw unlock --check >/dev/null 2>&1 \
    || fail 'credential phase failed: Bitwarden returned an invalid session'
}

secrets_mode=auto
case "${1:-}" in
  '') (( $# == 0 )) || fail 'usage: workstation-update [--skip-secrets | --refresh-secrets]' ;;
  --skip-secrets) secrets_mode=skip ;;
  --refresh-secrets) secrets_mode=refresh ;;
  --help|-h)
    printf 'Usage: workstation-update [--skip-secrets | --refresh-secrets]\n'
    printf 'With Bitwarden locked, press Enter to keep existing secret-backed files.\n'
    printf '  --skip-secrets     Keep existing files, even with an unlocked vault.\n'
    printf '  --refresh-secrets  Unlock if needed and refresh secret-backed files.\n'
    printf 'Missing, empty, or unreadable secret-backed files require unlocking.\n'
    exit 0 ;;
  *) fail 'usage: workstation-update [--skip-secrets | --refresh-secrets]' ;;
esac
(( $# <= 1 )) || fail 'usage: workstation-update [--skip-secrets | --refresh-secrets]'

select_secrets_mode() {
  local managed rendered skipped target answer
  local -a missing=()

  # The inventory difference identifies secret-backed files while chezmoi
  # handles host conditions and ignores.
  managed="$(chezmoi managed --include files,symlinks --path-style relative)" \
    || fail 'cannot inventory managed files'
  rendered="$(chezmoi dump --include files,symlinks --skip-secrets --format json)" \
    || fail 'cannot inspect files without secrets'
  skipped="$(jq -r --arg managed "$managed" '
    ($managed | split("\n")[] | select(length > 0)) as $path
    | select(has($path) | not) | $path
  ' <<<"$rendered")" || fail 'cannot identify secret-backed files'

  if [[ -z "$skipped" ]]; then
    printf 'Secrets: no files require unlocking.\n'
    chezmoi_secret_args=(--skip-secrets)
    return
  fi
  printf 'Secrets: skipping keeps these entire files unchanged:\n'
  while IFS= read -r target; do
    printf '  ~/%s\n' "$target"
    if [[ ! -f "$HOME/$target" || ! -s "$HOME/$target" || ! -r "$HOME/$target" ]]; then
      missing+=("$target")
    fi
  done <<<"$skipped"

  if (( ${#missing[@]} > 0 )); then
    printf 'Secrets: these files are missing, empty, or unreadable; unlocking is required:\n' >&2
    printf '  ~/%s\n' "${missing[@]}" >&2
    [[ "$secrets_mode" != skip ]] \
      || fail 'cannot skip required secrets; rerun with --refresh-secrets'
    ensure_bitwarden_session
    return
  fi
  if [[ "$secrets_mode" == refresh ]]; then
    ensure_bitwarden_session
    return
  fi
  if [[ "$secrets_mode" == auto ]]; then
    if command -v bw >/dev/null 2>&1 && bw unlock --check >/dev/null 2>&1; then
      printf 'Secrets: reusing the unlocked Bitwarden session.\n'
      return
    fi
    if [[ -t 0 && -t 2 ]]; then
      printf 'Secrets: Bitwarden is locked. Press Enter to keep existing files.\n' >&2
      printf 'Unlock and refresh secrets? [y/N] ' >&2
      IFS= read -r answer || answer=
      case "$answer" in
        y|Y|yes|YES) ensure_bitwarden_session; return ;;
      esac
    fi
  fi
  chezmoi_secret_args=(--skip-secrets)
  secrets_skipped=true
  printf 'Secrets: keeping existing files; refresh later with workstation-update --refresh-secrets.\n'
}

chezmoi_secret_args=()
secrets_skipped=false

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/workstation-update"
mkdir -p "$state_dir"
exec 8>"$state_dir/lock"
flock --nonblock 8 || fail 'workstation-update is already running'

[[ -e "$HOME/.local/state/workstation-setup/complete" ]] \
  || fail 'setup is incomplete; run workstation-setup'
source_repository="$(chezmoi source-path)" || fail 'chezmoi source path unavailable'
[[ -n "$source_repository" && "$source_repository" != *$'\n'* ]] \
  || fail 'unexpected chezmoi source path'
git -C "$source_repository" rev-parse --show-toplevel >/dev/null \
  || fail 'chezmoi source is not a Git repository'

validate_source() {
  local marker index_entries source_status
  local canonical_origin='git@github.com:faviann/dotfiles.git'

  [[ "$(git -C "$source_repository" config --get-all remote.origin.url)" == "$canonical_origin" \
    && "$(git -C "$source_repository" remote get-url --all origin)" == "$canonical_origin" ]] \
    || fail 'origin must be the canonical git@github.com:faviann/dotfiles.git'
  [[ "$(git -C "$source_repository" symbolic-ref --quiet --short HEAD)" == main ]] \
    || fail 'source branch must be main'
  [[ "$(git -C "$source_repository" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}')" == origin/main ]] \
    || fail 'source upstream must be origin/main'

  for marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG BISECT_START \
    NOTES_MERGE_PARTIAL NOTES_MERGE_REF NOTES_MERGE_WORKTREE \
    rebase-apply rebase-merge sequencer; do
    [[ ! -e "$(git -C "$source_repository" rev-parse --path-format=absolute --git-path "$marker")" ]] \
      || fail 'source has an unfinished Git operation'
  done
  index_entries="$(git -C "$source_repository" ls-files -v)" \
    || fail 'cannot inspect source index flags'
  if grep -Eq '^[a-zS] ' <<<"$index_entries"; then
    fail 'source index flags hide tracked content; restore normal index flags'
  fi
  source_status="$(git -C "$source_repository" status \
    --porcelain=v1 --untracked-files=all --ignored --ignore-submodules=none)" \
    || fail 'cannot inspect source status'
  [[ -z "$source_status" ]] || fail 'source has local content; commit or move it first'
}

start_phase '[1/9] Dotfiles: checking source and fetching origin/main...'
validate_source
git -C "$source_repository" fetch origin \
  '+refs/heads/main:refs/remotes/origin/main' || fail 'fetch failed'
validate_source
target_commit="$(git -C "$source_repository" rev-parse refs/remotes/origin/main)"
git -C "$source_repository" merge-base --is-ancestor HEAD "$target_commit" \
  || fail 'main is ahead of or diverged from origin/main'
# Git owns the index/worktree/ref update. Explicit flags prevent user merge
# defaults from stashing local work or overwriting ignored files.
git -C "$source_repository" merge --ff-only --no-autostash \
  --no-overwrite-ignore "$target_commit" || fail 'fast-forward failed'
validate_source
[[ "$(git -C "$source_repository" rev-parse HEAD)" == "$target_commit" ]] \
  || fail 'source changed during update'
finish_phase

# The config file is generated from the source's .chezmoi.toml.tmpl at init
# time and apply never refreshes it. Fast-forwarding the source alone leaves
# it stale, so a template reading a data key the old config lacks aborts the
# apply. Regenerate it from the source just fetched, before anything renders.
start_phase '[2/9] Dotfiles: refreshing chezmoi configuration...'
chezmoi init || fail 'chezmoi configuration refresh failed'
finish_phase

start_phase '[3/9] Secrets: checking whether unlocking is needed...'
select_secrets_mode
finish_phase
# Keep preview output to phase messages: rendered diffs can expose secrets.
start_phase '[4/9] Dotfiles: checking planned changes...'
chezmoi apply --dry-run --force=false "${chezmoi_secret_args[@]}" || fail 'chezmoi preview failed'
finish_phase
start_phase '[5/9] Dotfiles: applying changes and running lifecycle scripts...'
chezmoi apply --force=false "${chezmoi_secret_args[@]}" || fail 'chezmoi apply failed'
finish_phase
start_phase '[6/9] Dotfiles: verifying applied files...'
chezmoi verify --exclude scripts "${chezmoi_secret_args[@]}" || fail 'chezmoi verification failed'
finish_phase

# These commands already reconcile their own state. Always delegate so a
# previously interrupted apply or activation needs no local success cache.
start_phase '[7/9] Workstation configuration: checking...'
workstation-setup || fail 'workstation-setup failed'
finish_phase
start_phase '[8/9] Agent tools: updating...'
agent_tools="$HOME/.local/bin/update-agent-tools"
[[ -x "$agent_tools" ]] || fail 'managed update-agent-tools is not executable'
"$agent_tools" || fail 'update-agent-tools failed'
finish_phase
start_phase '[9/9] GitHub tokens: checking expiry...'
# Token expiry is advisory; a failed check must not fail the update.
"$HOME/.local/bin/github-token" check-expiry \
  || printf 'workstation-update: GitHub token expiry check failed; continuing\n' >&2
finish_phase
if [[ "$secrets_skipped" == true ]]; then
  printf 'Workstation update complete (secret-backed files kept unchanged; refresh deferred).\n'
else
  printf 'Workstation update complete\n'
fi
printf 'Total time: %ss\n' "$((SECONDS - update_started))"
