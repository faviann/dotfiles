#!/usr/bin/env bash
set -euo pipefail

fail() {
  printf 'workstation-update: %s; correct the problem, then rerun workstation-update\n' \
    "$*" >&2
  exit 1
}

readonly CANONICAL_ORIGIN='git@github.com:faviann/dotfiles.git'
readonly REQUIRED_BRANCH='main'
readonly REQUIRED_UPSTREAM='origin/main'
readonly STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
readonly STATE_DIR="$STATE_HOME/workstation-update"
readonly APPLIED_COMMIT_FILE="$STATE_DIR/applied-commit"
readonly DOTFILES_FRESHNESS_FILE="$STATE_DIR/dotfiles-freshness.json"

freshness_state_value() {
  local field="$1"

  if [[ -f "$DOTFILES_FRESHNESS_FILE" ]]; then
    jq -er ".$field // empty" "$DOTFILES_FRESHNESS_FILE" 2>/dev/null || true
  fi
}

write_dotfiles_freshness_state() {
  local attempt_status="$1"
  local cached_remote_commit="$2"
  local last_successful_check="$3"
  local temporary_state

  temporary_state="$(mktemp "$STATE_DIR/dotfiles-freshness.json.tmp.XXXXXX")" \
    || return 1
  chmod 600 "$temporary_state" || { rm -f "$temporary_state"; return 1; }
  jq -n \
    --arg last_attempt "$freshness_now_iso" \
    --arg last_successful_check "$last_successful_check" \
    --arg cached_remote_commit "$cached_remote_commit" \
    --arg attempt_status "$attempt_status" \
    '{
      last_attempt: $last_attempt,
      last_successful_check: (
        if $last_successful_check == "" then null else $last_successful_check end
      ),
      cached_remote_commit: (
        if $cached_remote_commit == "" then null else $cached_remote_commit end
      ),
      attempt_status: $attempt_status
    }' >"$temporary_state" \
    || { rm -f "$temporary_state"; return 1; }
  mv -f "$temporary_state" "$DOTFILES_FRESHNESS_FILE"
}

freshness_git_in_progress() {
  local git_path
  local marker

  for marker in \
    MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG BISECT_START \
    NOTES_MERGE_PARTIAL NOTES_MERGE_REF NOTES_MERGE_WORKTREE \
    rebase-apply rebase-merge sequencer; do
    git_path="$(git -C "$freshness_source_repository" rev-parse \
      --path-format=absolute --git-path "$marker" 2>/dev/null)" \
      || return 0
    [[ ! -e "$git_path" ]] || return 0
  done
  return 1
}

run_freshness() {
  local agent_error_file
  local agent_output_file
  local agent_pid=''
  local agent_status=0
  local agent_tools
  local applied_commit=''
  local branch
  local cached_remote_commit
  local dotfiles_due=1
  local dotfiles_error_file
  local dotfiles_last_attempt
  local dotfiles_last_successful
  local dotfiles_pid=''
  local dotfiles_status=0
  local effective_origin_urls=()
  local freshness_deadline
  local freshness_head=''
  local freshness_source_path
  local index_entries
  local last_attempt_status
  local next_check_epoch
  local origin_urls=()
  local source_status
  local upstream
  local agent_cached_result=''
  local agent_check_status=''
  local agent_last_successful=''
  local agent_activation_phase=''
  local agent_activation_component=''
  local agent_output=''
  local commit_count
  local local_short
  local local_tracking_commit=''
  local remote_short
  local history_counts
  local ahead_count
  local behind_count
  local dotfiles_failed=0
  local dotfiles_network_allowed=0
  local agent_failed=0
  local -a notice_lines=()
  local -a blocker_lines=()

  mkdir -p "$STATE_DIR" || return 0
  command -v flock >/dev/null 2>&1 || return 0
  exec 8>"$STATE_DIR/lock" || return 0
  flock --nonblock 8 || return 0

  freshness_now_epoch="$(date -u -d "${WORKSTATION_UPDATE_NOW:-now}" +%s 2>/dev/null)" \
    || return 0
  freshness_now_iso="$(date -u -d "@$freshness_now_epoch" +%Y-%m-%dT%H:%M:%SZ)" \
    || return 0
  freshness_deadline="${WORKSTATION_FRESHNESS_DEADLINE_SECONDS:-15}"
  [[ "$freshness_deadline" =~ ^[1-9][0-9]*$ ]] || freshness_deadline=15

  if [[ ! -e "$HOME/.local/state/workstation-setup/complete" ]]; then
    blocker_lines+=('Setup: workstation setup is incomplete')
  elif ! command -v chezmoi >/dev/null 2>&1; then
    blocker_lines+=('Dotfiles blocker: chezmoi is missing')
  elif ! freshness_source_path="$(chezmoi source-path 2>/dev/null)" \
    || [[ -z "$freshness_source_path" || "$freshness_source_path" == *$'\n'* ]]; then
    blocker_lines+=('Dotfiles blocker: source path is unavailable')
  elif ! freshness_source_repository="$(git -C "$freshness_source_path" \
    rev-parse --show-toplevel 2>/dev/null)"; then
    blocker_lines+=('Dotfiles blocker: source is not a Git repository')
  else
    mapfile -t origin_urls < <(
      git -C "$freshness_source_repository" config --get-all remote.origin.url
    )
    mapfile -t effective_origin_urls < <(
      git -C "$freshness_source_repository" remote get-url --all origin 2>/dev/null
    )
    branch="$(git -C "$freshness_source_repository" \
      symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
    upstream="$(git -C "$freshness_source_repository" rev-parse \
      --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
    if (( ${#origin_urls[@]} != 1 )) \
      || [[ "${origin_urls[0]:-}" != "$CANONICAL_ORIGIN" ]] \
      || (( ${#effective_origin_urls[@]} != 1 )) \
      || [[ "${effective_origin_urls[0]:-}" != "$CANONICAL_ORIGIN" ]]; then
      blocker_lines+=('Dotfiles blocker: repository origin is not canonical')
    elif [[ "$branch" != "$REQUIRED_BRANCH" ]]; then
      blocker_lines+=("Dotfiles blocker: branch must be $REQUIRED_BRANCH")
    elif [[ "$upstream" != "$REQUIRED_UPSTREAM" ]]; then
      blocker_lines+=("Dotfiles blocker: upstream must be $REQUIRED_UPSTREAM")
    elif freshness_git_in_progress; then
      blocker_lines+=('Dotfiles blocker: unfinished Git operation')
    else
      freshness_head="$(git -C "$freshness_source_repository" rev-parse HEAD 2>/dev/null || true)"
      index_entries="$(git -C "$freshness_source_repository" ls-files -v 2>/dev/null || true)"
      source_status="$(git -C "$freshness_source_repository" status \
        --porcelain=v1 --untracked-files=all --ignored \
        --ignore-submodules=none 2>/dev/null || printf '__inspection_failed__')"
      if grep -Eq '^[a-zS] ' <<<"$index_entries"; then
        blocker_lines+=('Dotfiles blocker: non-default index flags hide tracked content')
      elif [[ -n "$source_status" ]]; then
        blocker_lines+=('Dotfiles blocker: source repository has local content')
      else
        dotfiles_network_allowed=1
      fi
    fi
  fi

  if [[ -n "$freshness_head" ]]; then
    if [[ -f "$APPLIED_COMMIT_FILE" ]]; then
      applied_commit="$(<"$APPLIED_COMMIT_FILE")" || true
    fi
    if [[ "$applied_commit" != "$freshness_head" ]]; then
      blocker_lines+=('Dotfiles: fetched source has not been successfully applied')
    fi

    dotfiles_last_attempt="$(freshness_state_value last_attempt)"
    dotfiles_last_successful="$(freshness_state_value last_successful_check)"
    cached_remote_commit="$(freshness_state_value cached_remote_commit)"
    last_attempt_status="$(freshness_state_value attempt_status)"
    if [[ -n "$dotfiles_last_attempt" ]]; then
      if [[ "$last_attempt_status" == failed ]]; then
        next_check_epoch="$(date -u -d "$dotfiles_last_attempt + 1 hour" +%s 2>/dev/null || printf 0)"
      else
        next_check_epoch="$(date -u -d "$dotfiles_last_successful + 24 hours" +%s 2>/dev/null || printf 0)"
      fi
      if (( freshness_now_epoch < next_check_epoch )); then
        dotfiles_due=0
      fi
    fi
  fi

  dotfiles_error_file="$(mktemp "$STATE_DIR/dotfiles-check.stderr.XXXXXX")" || return 0
  agent_output_file="$(mktemp "$STATE_DIR/agent-check.stdout.XXXXXX")" || return 0
  agent_error_file="$(mktemp "$STATE_DIR/agent-check.stderr.XXXXXX")" || return 0
  trap 'rm -f "${dotfiles_error_file:-}" "${agent_output_file:-}" "${agent_error_file:-}"' RETURN

  if [[ -n "$freshness_head" ]] && (( dotfiles_due == 1 )) \
    && (( dotfiles_network_allowed == 1 )); then
    timeout --signal=TERM --kill-after=1s "${freshness_deadline}s" \
      git -C "$freshness_source_repository" fetch --prune origin \
        '+refs/heads/main:refs/remotes/origin/main' \
        >/dev/null 2>"$dotfiles_error_file" &
    dotfiles_pid=$!
  fi

  agent_tools="$HOME/.local/bin/update-agent-tools"
  if [[ -x "$agent_tools" ]]; then
    timeout --signal=TERM --kill-after=1s "${freshness_deadline}s" \
      "$agent_tools" --freshness-check-if-due \
      >"$agent_output_file" 2>"$agent_error_file" &
    agent_pid=$!
  else
    agent_failed=1
  fi

  if [[ -n "$dotfiles_pid" ]]; then
    wait "$dotfiles_pid" || dotfiles_status=$?
    if (( dotfiles_status == 0 )); then
      cached_remote_commit="$(git -C "$freshness_source_repository" \
        rev-parse refs/remotes/origin/main 2>/dev/null || true)"
      if [[ -n "$cached_remote_commit" ]]; then
        dotfiles_last_successful="$freshness_now_iso"
        write_dotfiles_freshness_state success \
          "$cached_remote_commit" "$dotfiles_last_successful" || dotfiles_failed=1
      else
        dotfiles_failed=1
      fi
    else
      dotfiles_failed=1
      write_dotfiles_freshness_state failed \
        "$cached_remote_commit" "$dotfiles_last_successful" || true
    fi
  elif [[ -n "$freshness_head" && "$last_attempt_status" == failed ]]; then
    dotfiles_failed=1
  fi

  if [[ -n "$agent_pid" ]]; then
    wait "$agent_pid" || agent_status=$?
    (( agent_status == 0 )) || agent_failed=1
  fi

  if [[ -n "$freshness_head" ]]; then
    local_tracking_commit="$(git -C "$freshness_source_repository" \
      rev-parse refs/remotes/origin/main 2>/dev/null || true)"
  fi
  if [[ -n "$freshness_head" && -n "$local_tracking_commit" ]]; then
    history_counts="$(git -C "$freshness_source_repository" rev-list \
      --left-right --count "$freshness_head...$local_tracking_commit" \
      2>/dev/null || true)"
    read -r ahead_count behind_count <<<"$history_counts"
    ahead_count="${ahead_count:-0}"
    behind_count="${behind_count:-0}"
    if (( ahead_count > 0 && behind_count > 0 )); then
      blocker_lines+=("Dotfiles blocker: main has diverged ($ahead_count ahead, $behind_count behind)")
    elif (( ahead_count > 0 )); then
      blocker_lines+=("Dotfiles blocker: main is ahead by $ahead_count commit(s)")
    fi
  fi

  if [[ -n "$freshness_head" && -n "$cached_remote_commit" ]] \
    && git -C "$freshness_source_repository" cat-file -e \
      "$cached_remote_commit^{commit}" 2>/dev/null; then
    history_counts="$(git -C "$freshness_source_repository" rev-list \
      --left-right --count "$freshness_head...$cached_remote_commit" 2>/dev/null || true)"
    read -r ahead_count behind_count <<<"$history_counts"
    ahead_count="${ahead_count:-0}"
    behind_count="${behind_count:-0}"
    if (( ahead_count == 0 && behind_count > 0 )); then
      commit_count="$behind_count"
      local_short="$(git -C "$freshness_source_repository" rev-parse --short "$freshness_head")"
      remote_short="$(git -C "$freshness_source_repository" rev-parse --short "$cached_remote_commit")"
      notice_lines+=("Dotfiles: $commit_count commit$( (( commit_count == 1 )) || printf s ) (sanitized below)")
      notice_lines+=("  $local_short..$remote_short")
    fi
  fi
  if (( dotfiles_failed == 1 )); then
    if [[ -n "$dotfiles_last_successful" ]]; then
      notice_lines+=("Dotfiles: freshness check failed; using result from $dotfiles_last_successful")
    else
      notice_lines+=('Dotfiles: freshness check failed; no successful result is available')
    fi
  fi

  if [[ -f "$STATE_HOME/update-agent-tools/state.json" ]]; then
    agent_cached_result="$(jq -er '.cached_version_result // empty' \
      "$STATE_HOME/update-agent-tools/state.json" 2>/dev/null || true)"
    agent_check_status="$(jq -er '.check_status // empty' \
      "$STATE_HOME/update-agent-tools/state.json" 2>/dev/null || true)"
    agent_last_successful="$(jq -er '.last_successful_check // empty' \
      "$STATE_HOME/update-agent-tools/state.json" 2>/dev/null || true)"
    agent_activation_phase="$(jq -er '.activation_failure.phase // empty' \
      "$STATE_HOME/update-agent-tools/state.json" 2>/dev/null || true)"
    agent_activation_component="$(jq -er '.activation_failure.component // empty' \
      "$STATE_HOME/update-agent-tools/state.json" 2>/dev/null || true)"
  fi
  if [[ "$agent_check_status" == failed ]]; then
    agent_failed=1
  fi
  agent_output="$(sed '/^Run: update-agent-tools$/d' "$agent_output_file")"
  if [[ -z "$agent_output" ]]; then
    agent_output="$agent_cached_result"
  fi
  if [[ -n "$agent_output" ]]; then
    notice_lines+=('Agent tools:')
    while IFS= read -r line; do
      [[ -n "$line" ]] && notice_lines+=("  $line")
    done <<<"$agent_output"
  fi
  if (( agent_failed == 1 )); then
    if [[ -n "$agent_last_successful" ]]; then
      notice_lines+=("Agent tools: freshness check failed; using result from $agent_last_successful")
    else
      notice_lines+=('Agent tools: freshness check failed; no successful result is available')
    fi
  fi
  if [[ -n "$agent_activation_phase" ]]; then
    notice_lines+=("Agent tools: unfinished $agent_activation_phase for $agent_activation_component")
  fi

  notice_lines+=("${blocker_lines[@]}")
  if (( ${#notice_lines[@]} > 0 )); then
    printf 'Workstation maintenance available:\n'
    printf '%s\n' "${notice_lines[@]}"
    printf 'Run: workstation-update\n'
  fi
}

if [[ "${1:-}" == '--freshness' ]]; then
  if (( $# != 1 )); then
    exit 0
  fi
  run_freshness
  exit 0
fi

assume_yes=0
if (( $# == 1 )) && [[ "$1" == '--yes' ]]; then
  assume_yes=1
elif (( $# != 0 )); then
  unsupported_argument=''
  for argument in "$@"; do
    if [[ "$argument" != '--yes' ]]; then
      unsupported_argument="$argument"
      break
    fi
  done
  if [[ -n "$unsupported_argument" ]]; then
    fail "argument phase failed: expected no arguments or --yes; unsupported argument: $unsupported_argument"
  fi
  fail "argument phase failed: expected no arguments or --yes; received $# arguments"
fi

mkdir -p "$STATE_DIR" \
  || fail 'lock phase failed: cannot create workstation-update state directory'
command -v flock >/dev/null 2>&1 \
  || fail 'lock phase failed: flock is missing from PATH'
exec 8>"$STATE_DIR/lock" \
  || fail 'lock phase failed: cannot open workstation-update lock'
flock --nonblock 8 \
  || fail 'lock phase failed: workstation-update is already running'

git_in_progress() {
  local git_path
  local marker

  for marker in \
    MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG BISECT_START \
    NOTES_MERGE_PARTIAL NOTES_MERGE_REF NOTES_MERGE_WORKTREE \
    rebase-apply rebase-merge sequencer; do
    git_path="$(git -C "$source_repository" rev-parse \
      --path-format=absolute --git-path "$marker")" \
      || return 0
    [[ ! -e "$git_path" ]] || return 0
  done
  return 1
}

reject_hidden_index_entries() {
  local index_entries

  index_entries="$(git -C "$source_repository" ls-files -v)" \
    || fail 'source validation failed: cannot inspect index flags'
  if grep -Eq '^[a-zS] ' <<<"$index_entries"; then
    fail 'source validation failed: non-default index flags hide tracked content'
  fi
}

ref_transaction_active=0
ref_transaction_input_fd=''
ref_transaction_output_fd=''
ref_transaction_pid=''

abort_ref_transaction() {
  local response

  (( ref_transaction_active == 1 )) || return 0
  if [[ -n "${ref_transaction_input_fd:-}" ]]; then
    { printf 'abort\n' >&"$ref_transaction_input_fd" || true; } 2>/dev/null
    exec {ref_transaction_input_fd}>&- 2>/dev/null || true
  fi
  if [[ -n "${ref_transaction_output_fd:-}" ]]; then
    IFS= read -r response <&"$ref_transaction_output_fd" 2>/dev/null || true
    exec {ref_transaction_output_fd}<&- 2>/dev/null || true
  fi
  if [[ -n "${ref_transaction_pid:-}" ]]; then
    wait "$ref_transaction_pid" 2>/dev/null || true
  fi
  ref_transaction_active=0
}

prepare_guarded_main_update() {
  local response

  coproc REF_TRANSACTION {
    git -C "$source_repository" update-ref --stdin
  }
  ref_transaction_output_fd="${REF_TRANSACTION[0]}"
  ref_transaction_input_fd="${REF_TRANSACTION[1]}"
  # Bash creates this PID variable dynamically from the coprocess name.
  # shellcheck disable=SC2153
  ref_transaction_pid="$REF_TRANSACTION_PID"
  ref_transaction_active=1
  trap abort_ref_transaction EXIT

  printf 'start\nupdate refs/heads/main %s %s\nprepare\n' \
    "$new_head" "$old_head" >&"$ref_transaction_input_fd" \
    || fail 'history phase failed: cannot start guarded main update'
  IFS= read -r response <&"$ref_transaction_output_fd" \
    || fail 'history phase failed: cannot prepare guarded main update'
  [[ "$response" == 'start: ok' ]] \
    || fail 'history phase failed: cannot start guarded main update'
  IFS= read -r response <&"$ref_transaction_output_fd" \
    || fail 'history phase failed: cannot prepare guarded main update'
  [[ "$response" == 'prepare: ok' ]] \
    || fail 'history phase failed: cannot prepare guarded main update'
}

commit_guarded_main_update() {
  local response
  local transaction_status=0

  printf 'commit\n' >&"$ref_transaction_input_fd" \
    || fail 'history phase failed: cannot commit guarded main update'
  IFS= read -r response <&"$ref_transaction_output_fd" \
    || fail 'history phase failed: cannot commit guarded main update'
  [[ "$response" == 'commit: ok' ]] \
    || fail 'history phase failed: cannot commit guarded main update'

  exec {ref_transaction_input_fd}>&-
  exec {ref_transaction_output_fd}<&-
  wait "$ref_transaction_pid" || transaction_status=$?
  ref_transaction_active=0
  ref_transaction_pid=''
  trap - EXIT
  (( transaction_status == 0 )) \
    || fail 'history phase failed: guarded main transaction failed'
}

record_applied_commit() {
  local temporary_marker

  mkdir -p "$STATE_DIR" || fail 'marker phase failed: state directory'
  temporary_marker="$(mktemp "$STATE_DIR/applied-commit.tmp.XXXXXX")" \
    || fail 'marker phase failed: temporary marker'
  trap 'rm -f "${temporary_marker:-}"' EXIT
  chmod 600 "$temporary_marker" \
    || fail 'marker phase failed: marker permissions'
  printf '%s\n' "$head_commit" >"$temporary_marker" \
    || fail 'marker phase failed: marker write'
  mv -f "$temporary_marker" "$APPLIED_COMMIT_FILE" \
    || fail 'marker phase failed: marker replacement'
  temporary_marker=''
  trap - EXIT
}

[[ -e "$HOME/.local/state/workstation-setup/complete" ]] \
  || fail 'setup phase failed: setup is incomplete'

command -v chezmoi >/dev/null 2>&1 || fail 'source discovery failed: chezmoi missing'
source_path="$(chezmoi source-path)" \
  || fail 'source discovery failed: chezmoi source path unavailable'
[[ -n "$source_path" && "$source_path" != *$'\n'* ]] \
  || fail 'source discovery failed: unexpected chezmoi source path'
source_repository="$(git -C "$source_path" rev-parse --show-toplevel 2>/dev/null)" \
  || fail 'source validation failed: source is not a Git repository'

origin_urls=()
mapfile -t origin_urls < <(
  git -C "$source_repository" config --get-all remote.origin.url
)
(( ${#origin_urls[@]} == 1 )) \
  || fail 'source validation failed: origin must have exactly one URL'
[[ "${origin_urls[0]}" == "$CANONICAL_ORIGIN" ]] \
  || fail "source validation failed: origin must be $CANONICAL_ORIGIN"

effective_origin_urls=()
mapfile -t effective_origin_urls < <(
  git -C "$source_repository" remote get-url --all origin
)
(( ${#effective_origin_urls[@]} == 1 )) \
  || fail 'source validation failed: effective origin must have exactly one URL'
[[ "${effective_origin_urls[0]}" == "$CANONICAL_ORIGIN" ]] \
  || fail 'source validation failed: effective origin must be canonical'

branch="$(git -C "$source_repository" symbolic-ref --quiet --short HEAD || true)"
[[ -n "$branch" ]] || fail 'source validation failed: detached HEAD'
[[ "$branch" == "$REQUIRED_BRANCH" ]] \
  || fail "source validation failed: branch must be $REQUIRED_BRANCH"

upstream="$(git -C "$source_repository" \
  rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
[[ "$upstream" == "$REQUIRED_UPSTREAM" ]] \
  || fail "source validation failed: upstream must be $REQUIRED_UPSTREAM"

git_in_progress \
  && fail 'source validation failed: unfinished Git operation'
reject_hidden_index_entries
source_status="$(git -C "$source_repository" status \
  --porcelain=v1 --untracked-files=all --ignored --ignore-submodules=none)" \
  || fail 'source validation failed: cannot inspect source repository'
[[ -z "$source_status" ]] \
  || fail 'source validation failed: source repository has local content'

git -C "$source_repository" fetch --prune origin \
  '+refs/heads/main:refs/remotes/origin/main' \
  || fail 'fetch phase failed: origin/main unavailable'

git_in_progress \
  && fail 'source validation failed: unfinished Git operation after fetch'
reject_hidden_index_entries
source_status="$(git -C "$source_repository" status \
  --porcelain=v1 --untracked-files=all --ignored --ignore-submodules=none)" \
  || fail 'source validation failed: cannot inspect source after fetch'
[[ -z "$source_status" ]] \
  || fail 'source validation failed: source gained local content during fetch'

old_head="$(git -C "$source_repository" rev-parse refs/heads/main)" \
  || fail 'history phase failed: cannot read main'
new_head="$(git -C "$source_repository" rev-parse refs/remotes/origin/main)" \
  || fail 'history phase failed: cannot read origin/main'
read -r ahead_count behind_count < <(
  git -C "$source_repository" rev-list --left-right --count \
    "$old_head...$new_head"
) || fail 'history phase failed: cannot compare HEAD with origin/main'

if (( ahead_count > 0 && behind_count > 0 )); then
  fail "history phase failed: main has diverged from origin/main ($ahead_count ahead, $behind_count behind)"
fi
if (( ahead_count > 0 )); then
  fail "history phase failed: main is ahead of origin/main by $ahead_count commit(s)"
fi
if (( behind_count > 0 )); then
  old_tree="$(git -C "$source_repository" rev-parse "$old_head^{tree}")" \
    || fail 'history phase failed: cannot read the current tree'
  new_tree="$(git -C "$source_repository" rev-parse "$new_head^{tree}")" \
    || fail 'history phase failed: cannot read the upstream tree'
  prepare_guarded_main_update
  prepared_tree="$(git -C "$source_repository" write-tree)" \
    || fail 'history phase failed: cannot verify the prepared index'
  [[ "$prepared_tree" == "$old_tree" ]] \
    || fail 'history phase failed: paths changed before ref preparation'
  git -C "$source_repository" diff-files \
    --quiet --ignore-submodules=none -- \
    || fail 'history phase failed: worktree changed before ref preparation'
  git -C "$source_repository" read-tree -u -m "$old_tree" "$new_tree" \
    || fail 'history phase failed: cannot write the upstream tree'
  written_tree="$(git -C "$source_repository" write-tree)" \
    || fail 'history phase failed: cannot verify the updated index'
  [[ "$written_tree" == "$new_tree" ]] \
    || fail 'history phase failed: updated index does not match origin/main'
  git -C "$source_repository" diff-files \
    --quiet --ignore-submodules=none -- \
    || fail 'history phase failed: updated worktree does not match the index'
  reject_hidden_index_entries
  commit_guarded_main_update
fi

git_in_progress \
  && fail 'source validation failed: unfinished Git operation after update'
reject_hidden_index_entries
source_status="$(git -C "$source_repository" status \
  --porcelain=v1 --untracked-files=all --ignored --ignore-submodules=none)" \
  || fail 'source validation failed: cannot inspect source after update'
[[ -z "$source_status" ]] \
  || fail 'source validation failed: source gained local content during update'

head_commit="$(git -C "$source_repository" rev-parse HEAD)" \
  || fail 'history phase failed: cannot read HEAD'
[[ "$head_commit" == "$new_head" ]] \
  || fail 'history phase failed: main does not match origin/main'

apply_required=0
if [[ ! -e "$APPLIED_COMMIT_FILE" ]]; then
  if chezmoi verify; then
    record_applied_commit
  else
    apply_required=1
  fi
else
  applied_commit=''
  if [[ -f "$APPLIED_COMMIT_FILE" ]]; then
    applied_commit="$(<"$APPLIED_COMMIT_FILE")" || true
  fi
  if [[ "$applied_commit" != "$head_commit" ]]; then
    apply_required=1
  elif ! chezmoi verify \
    "$HOME/.local/bin/workstation-update" \
    "$HOME/.local/bin/update-agent-tools"; then
    apply_required=1
  fi
fi

if (( apply_required == 1 )); then
  chezmoi apply --dry-run --verbose \
    || fail 'dry-run phase failed: chezmoi apply preview'
  chezmoi apply \
    || fail 'apply phase failed: chezmoi apply'
  chezmoi verify \
    || fail 'verification phase failed: chezmoi targets'
  record_applied_commit
fi

agent_tools="$HOME/.local/bin/update-agent-tools"
[[ -x "$agent_tools" ]] \
  || fail 'agent-tools phase failed: managed update-agent-tools is not executable'
agent_tools_arguments=(--update-if-needed)
if (( assume_yes == 1 )); then
  agent_tools_arguments+=(--yes)
fi
"$agent_tools" "${agent_tools_arguments[@]}" \
  || fail 'agent-tools phase failed: update-agent-tools'
