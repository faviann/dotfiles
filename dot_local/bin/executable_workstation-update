#!/usr/bin/env bash
set -euo pipefail

fail() {
  printf 'workstation-update: %s\n' "$*" >&2
  exit 1
}

readonly CANONICAL_ORIGIN='git@github.com:faviann/dotfiles.git'
readonly REQUIRED_BRANCH='main'
readonly REQUIRED_UPSTREAM='origin/main'
readonly STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
readonly STATE_DIR="$STATE_HOME/workstation-update"
readonly APPLIED_COMMIT_FILE="$STATE_DIR/applied-commit"

git_in_progress() {
  local git_path
  local marker

  for marker in \
    MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG BISECT_START \
    NOTES_MERGE_PARTIAL NOTES_MERGE_REF NOTES_MERGE_WORKTREE \
    rebase-apply rebase-merge sequencer; do
    git_path="$(git -C "$source_repository" rev-parse \
      --path-format=absolute --git-path "$marker")" \
      || return 0
    [[ ! -e "$git_path" ]] || return 0
  done
  return 1
}

reject_hidden_index_entries() {
  local index_entries

  index_entries="$(git -C "$source_repository" ls-files -v)" \
    || fail 'source validation failed: cannot inspect index flags'
  if grep -Eq '^[a-zS] ' <<<"$index_entries"; then
    fail 'source validation failed: non-default index flags hide tracked content'
  fi
}

ref_transaction_active=0
ref_transaction_input_fd=''
ref_transaction_output_fd=''
ref_transaction_pid=''

abort_ref_transaction() {
  local response

  (( ref_transaction_active == 1 )) || return 0
  if [[ -n "${ref_transaction_input_fd:-}" ]]; then
    printf 'abort\n' >&"$ref_transaction_input_fd" 2>/dev/null || true
    exec {ref_transaction_input_fd}>&- 2>/dev/null || true
  fi
  if [[ -n "${ref_transaction_output_fd:-}" ]]; then
    IFS= read -r response <&"$ref_transaction_output_fd" 2>/dev/null || true
    exec {ref_transaction_output_fd}<&- 2>/dev/null || true
  fi
  if [[ -n "${ref_transaction_pid:-}" ]]; then
    wait "$ref_transaction_pid" 2>/dev/null || true
  fi
  ref_transaction_active=0
}

prepare_guarded_main_update() {
  local response

  coproc REF_TRANSACTION {
    git -C "$source_repository" update-ref --stdin
  }
  ref_transaction_output_fd="${REF_TRANSACTION[0]}"
  ref_transaction_input_fd="${REF_TRANSACTION[1]}"
  ref_transaction_pid="$REF_TRANSACTION_PID"
  ref_transaction_active=1
  trap abort_ref_transaction EXIT

  printf 'start\nupdate refs/heads/main %s %s\nprepare\n' \
    "$new_head" "$old_head" >&"$ref_transaction_input_fd" \
    || fail 'history phase failed: cannot start guarded main update'
  IFS= read -r response <&"$ref_transaction_output_fd" \
    || fail 'history phase failed: cannot prepare guarded main update'
  [[ "$response" == 'start: ok' ]] \
    || fail 'history phase failed: cannot start guarded main update'
  IFS= read -r response <&"$ref_transaction_output_fd" \
    || fail 'history phase failed: cannot prepare guarded main update'
  [[ "$response" == 'prepare: ok' ]] \
    || fail 'history phase failed: cannot prepare guarded main update'
}

commit_guarded_main_update() {
  local response
  local transaction_status=0

  printf 'commit\n' >&"$ref_transaction_input_fd" \
    || fail 'history phase failed: cannot commit guarded main update'
  IFS= read -r response <&"$ref_transaction_output_fd" \
    || fail 'history phase failed: cannot commit guarded main update'
  [[ "$response" == 'commit: ok' ]] \
    || fail 'history phase failed: cannot commit guarded main update'

  exec {ref_transaction_input_fd}>&-
  exec {ref_transaction_output_fd}<&-
  wait "$ref_transaction_pid" || transaction_status=$?
  ref_transaction_active=0
  ref_transaction_pid=''
  trap - EXIT
  (( transaction_status == 0 )) \
    || fail 'history phase failed: guarded main transaction failed'
}

record_applied_commit() {
  local temporary_marker

  mkdir -p "$STATE_DIR" || fail 'marker phase failed: state directory'
  temporary_marker="$(mktemp "$STATE_DIR/applied-commit.tmp.XXXXXX")" \
    || fail 'marker phase failed: temporary marker'
  trap 'rm -f "${temporary_marker:-}"' EXIT
  chmod 600 "$temporary_marker" \
    || fail 'marker phase failed: marker permissions'
  printf '%s\n' "$head_commit" >"$temporary_marker" \
    || fail 'marker phase failed: marker write'
  mv -f "$temporary_marker" "$APPLIED_COMMIT_FILE" \
    || fail 'marker phase failed: marker replacement'
  temporary_marker=''
  trap - EXIT
}

[[ -e "$HOME/.local/state/workstation-setup/complete" ]] \
  || fail 'setup is incomplete'

command -v chezmoi >/dev/null 2>&1 || fail 'source discovery failed: chezmoi missing'
source_path="$(chezmoi source-path)" \
  || fail 'source discovery failed: chezmoi source path unavailable'
[[ -n "$source_path" && "$source_path" != *$'\n'* ]] \
  || fail 'source discovery failed: unexpected chezmoi source path'
source_repository="$(git -C "$source_path" rev-parse --show-toplevel 2>/dev/null)" \
  || fail 'source validation failed: source is not a Git repository'

origin_urls=()
mapfile -t origin_urls < <(
  git -C "$source_repository" config --get-all remote.origin.url
)
(( ${#origin_urls[@]} == 1 )) \
  || fail 'source validation failed: origin must have exactly one URL'
[[ "${origin_urls[0]}" == "$CANONICAL_ORIGIN" ]] \
  || fail "source validation failed: origin must be $CANONICAL_ORIGIN"

effective_origin_urls=()
mapfile -t effective_origin_urls < <(
  git -C "$source_repository" remote get-url --all origin
)
(( ${#effective_origin_urls[@]} == 1 )) \
  || fail 'source validation failed: effective origin must have exactly one URL'
[[ "${effective_origin_urls[0]}" == "$CANONICAL_ORIGIN" ]] \
  || fail 'source validation failed: effective origin must be canonical'

branch="$(git -C "$source_repository" symbolic-ref --quiet --short HEAD || true)"
[[ -n "$branch" ]] || fail 'source validation failed: detached HEAD'
[[ "$branch" == "$REQUIRED_BRANCH" ]] \
  || fail "source validation failed: branch must be $REQUIRED_BRANCH"

upstream="$(git -C "$source_repository" \
  rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
[[ "$upstream" == "$REQUIRED_UPSTREAM" ]] \
  || fail "source validation failed: upstream must be $REQUIRED_UPSTREAM"

git_in_progress \
  && fail 'source validation failed: unfinished Git operation'
reject_hidden_index_entries
source_status="$(git -C "$source_repository" status \
  --porcelain=v1 --untracked-files=all --ignored --ignore-submodules=none)" \
  || fail 'source validation failed: cannot inspect source repository'
[[ -z "$source_status" ]] \
  || fail 'source validation failed: source repository has local content'

git -C "$source_repository" fetch --prune origin \
  '+refs/heads/main:refs/remotes/origin/main' \
  || fail 'fetch phase failed: origin/main unavailable'

git_in_progress \
  && fail 'source validation failed: unfinished Git operation after fetch'
reject_hidden_index_entries
source_status="$(git -C "$source_repository" status \
  --porcelain=v1 --untracked-files=all --ignored --ignore-submodules=none)" \
  || fail 'source validation failed: cannot inspect source after fetch'
[[ -z "$source_status" ]] \
  || fail 'source validation failed: source gained local content during fetch'

old_head="$(git -C "$source_repository" rev-parse refs/heads/main)" \
  || fail 'history phase failed: cannot read main'
new_head="$(git -C "$source_repository" rev-parse refs/remotes/origin/main)" \
  || fail 'history phase failed: cannot read origin/main'
read -r ahead_count behind_count < <(
  git -C "$source_repository" rev-list --left-right --count \
    "$old_head...$new_head"
) || fail 'history phase failed: cannot compare HEAD with origin/main'

if (( ahead_count > 0 && behind_count > 0 )); then
  fail "history phase failed: main has diverged from origin/main ($ahead_count ahead, $behind_count behind)"
fi
if (( ahead_count > 0 )); then
  fail "history phase failed: main is ahead of origin/main by $ahead_count commit(s)"
fi
if (( behind_count > 0 )); then
  old_tree="$(git -C "$source_repository" rev-parse "$old_head^{tree}")" \
    || fail 'history phase failed: cannot read the current tree'
  new_tree="$(git -C "$source_repository" rev-parse "$new_head^{tree}")" \
    || fail 'history phase failed: cannot read the upstream tree'
  prepare_guarded_main_update
  prepared_tree="$(git -C "$source_repository" write-tree)" \
    || fail 'history phase failed: cannot verify the prepared index'
  [[ "$prepared_tree" == "$old_tree" ]] \
    || fail 'history phase failed: paths changed before ref preparation'
  git -C "$source_repository" diff-files \
    --quiet --ignore-submodules=none -- \
    || fail 'history phase failed: worktree changed before ref preparation'
  git -C "$source_repository" read-tree -u -m "$old_tree" "$new_tree" \
    || fail 'history phase failed: cannot write the upstream tree'
  written_tree="$(git -C "$source_repository" write-tree)" \
    || fail 'history phase failed: cannot verify the updated index'
  [[ "$written_tree" == "$new_tree" ]] \
    || fail 'history phase failed: updated index does not match origin/main'
  git -C "$source_repository" diff-files \
    --quiet --ignore-submodules=none -- \
    || fail 'history phase failed: updated worktree does not match the index'
  reject_hidden_index_entries
  commit_guarded_main_update
fi

git_in_progress \
  && fail 'source validation failed: unfinished Git operation after update'
reject_hidden_index_entries
source_status="$(git -C "$source_repository" status \
  --porcelain=v1 --untracked-files=all --ignored --ignore-submodules=none)" \
  || fail 'source validation failed: cannot inspect source after update'
[[ -z "$source_status" ]] \
  || fail 'source validation failed: source gained local content during update'

head_commit="$(git -C "$source_repository" rev-parse HEAD)" \
  || fail 'history phase failed: cannot read HEAD'
[[ "$head_commit" == "$new_head" ]] \
  || fail 'history phase failed: main does not match origin/main'

apply_required=0
if [[ ! -e "$APPLIED_COMMIT_FILE" ]]; then
  if chezmoi verify; then
    record_applied_commit
    exit 0
  fi
  apply_required=1
else
  applied_commit=''
  if [[ -f "$APPLIED_COMMIT_FILE" ]]; then
    applied_commit="$(<"$APPLIED_COMMIT_FILE")" || true
  fi
  if [[ "$applied_commit" != "$head_commit" ]]; then
    apply_required=1
  elif ! chezmoi verify \
    "$HOME/.local/bin/workstation-update" \
    "$HOME/.local/bin/update-agent-tools"; then
    apply_required=1
  fi
fi

if (( apply_required == 0 )); then
  exit 0
fi

chezmoi apply --dry-run --verbose \
  || fail 'dry-run phase failed: chezmoi apply preview'
chezmoi apply \
  || fail 'apply phase failed: chezmoi apply'
chezmoi verify \
  || fail 'verification phase failed: chezmoi targets'
record_applied_commit
