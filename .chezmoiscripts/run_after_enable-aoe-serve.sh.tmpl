#!/usr/bin/env bash
set -euo pipefail

if ! command -v aoe >/dev/null 2>&1; then
    exit 0
fi

systemctl --user daemon-reload
systemctl --user enable aoe-serve.service aoe-lan-proxy.socket

if systemctl --user is-active --quiet aoe-serve.service; then
    systemctl --user restart aoe-serve.service
else
    systemctl --user start aoe-serve.service
fi

if systemctl --user is-active --quiet aoe-lan-proxy.socket; then
    systemctl --user restart aoe-lan-proxy.socket
else
    systemctl --user start aoe-lan-proxy.socket
fi