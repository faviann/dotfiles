#!/usr/bin/env bash
set -euo pipefail

readonly skillset_repo="$HOME/repos/skillset"
readonly skillset_url="https://github.com/faviann/skillset.git"
readonly reconciler="$skillset_repo/scripts/reconcile-skills.sh"

if [[ -e "$skillset_repo" || -L "$skillset_repo" ]]; then
  checkout_root="$(git -C "$skillset_repo" rev-parse --show-toplevel 2>/dev/null || true)"
  if [[ "$checkout_root" != "$skillset_repo" ]]; then
    printf 'error: skillset path is not a Git checkout: %s\n' "$skillset_repo" >&2
    exit 1
  fi
else
  mkdir -p "$(dirname "$skillset_repo")"
  git clone "$skillset_url" "$skillset_repo"
  git -C "$skillset_repo" submodule update --init --recursive --checkout
fi

if [[ ! -x "$reconciler" ]]; then
  printf 'error: skillset reconciler is missing or not executable: %s\n' \
    "$reconciler" >&2
  exit 1
fi

# The reconciler is repository-owned code from a checkout this hook deliberately
# does not pin or verify. Applying dotfiles can carry an unlocked vault session
# (workstation-update exports BW_SESSION before chezmoi apply), and linking
# skills never needs it, so withhold it.
env -u BW_SESSION "$reconciler"
