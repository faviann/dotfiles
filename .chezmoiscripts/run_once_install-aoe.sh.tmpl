#!/usr/bin/env bash
set -euo pipefail

if command -v aoe >/dev/null 2>&1; then
    exit 0
fi

readonly AOE_INSTALL_REF="main"
readonly AOE_INSTALL_URL="https://raw.githubusercontent.com/njbrake/agent-of-empires/${AOE_INSTALL_REF}/scripts/install.sh"

tmp_script="$(mktemp)"
trap 'rm -f "$tmp_script"' EXIT

curl -fsSL "$AOE_INSTALL_URL" -o "$tmp_script"
INSTALL_DIR="$HOME/.local/bin" bash "$tmp_script"
