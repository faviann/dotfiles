#!/usr/bin/env bash
set -euo pipefail

# flake.lock: {{ include "flake.lock" | sha256sum }}
# flake.nix: {{ include "flake.nix" | sha256sum }}
{{- range glob (joinPath .chezmoi.sourceDir "home" "*") }}
# {{ base . }}: {{ include . | sha256sum }}
{{- end }}
{{- range glob (joinPath .chezmoi.sourceDir "packages" "*") }}
# {{ base . }}: {{ include . | sha256sum }}
{{- end }}

readonly source_dir={{ .chezmoi.sourceDir | quote }}

if ! command -v nix >/dev/null 2>&1; then
  printf 'error: nix is not on PATH. Install Determinate Nix as in step 1 of BOOTSTRAP.md, then open a new shell and rerun chezmoi apply.\n' >&2
  exit 1
fi

# The desktop profile names its user and home from the environment so the same
# flake serves every machine. A bare container shell may leave USER unset.
USER="$(id -un)"
export USER HOME

nix run "$source_dir#home-manager" -- switch --impure --flake "$source_dir#desktop"
