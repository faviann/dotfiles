#!/usr/bin/env bash
set -euo pipefail

# The workstation bind-mounts this one file, so it cannot be a chezmoi target:
# chezmoi replaces targets by rename, which fails on a mount point.
config="$HOME/.claude.json"
url={{ printf "%s/mcp" .artifactServer.url | squote }}
helper="'$HOME/.local/bin/artifact-server-mcp-headers'"

if ! command -v jq >/dev/null; then
  printf 'register-claude-mcp-server: jq is not installed yet; the next apply registers the artifact-server MCP server\n' >&2
  exit 0
fi

umask 077
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

input="$config"
[[ -e "$config" ]] || input=/dev/null

if ! jq --slurp --arg url "$url" --arg helper "$helper" '
  if length > 1 then error("more than one JSON value") else .[0] // {} end
  | (.mcpServers["artifact-server"] // {}) as $current
  | (($current | del(.headers)) + {type: "http", url: $url, headersHelper: $helper}) as $server
  | if $server == $current then empty else .mcpServers["artifact-server"] = $server end
' "$input" >"$tmp"; then
  printf 'error: cannot register the artifact-server MCP server in %s\n' "$config" >&2
  exit 1
fi

if [[ -s "$tmp" ]]; then
  cat "$tmp" >"$config"
fi
[[ "$(stat -c %a "$config")" == 600 ]] || chmod 600 "$config"
